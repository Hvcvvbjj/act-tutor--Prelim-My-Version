# Hidden AlexACT developer mode. The normal sign-in form unlocks it only when
# these server-side credentials match. In production, use the password hash and
# never deploy SCOUT_DEV_PASSWORD in readable form.
# Hash format: pbkdf2-sha256:100000:base64url-salt:base64url-digest
SCOUT_DEV_USERNAME=
SCOUT_DEV_PASSWORD=
SCOUT_DEV_PASSWORD_HASH=
# Put the matching readable password only in the ignored .env.e2e.local file.
SCOUT_E2E_DEV_PASSWORD=

# Optional lesson-reminder delivery. Preferences can be saved without these
# values, but the backend will not contact either provider until the complete
# provider configuration is present.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Daily cron authentication and the HTTPS link included in reminders. Use a
# random secret of at least 24 characters. The cron calls
# POST /api/reminders/dispatch with Authorization: Bearer <secret>.
SCOUT_REMINDER_CRON_SECRET=
ALEXACT_PUBLIC_URL=

# Hosted Mr. Kim AI. Keep OPENAI_API_KEY server-side and store it as a secret
# in the hosting environment. OPENAI_MODEL is optional.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# Optional free local OpenAI-compatible provider (for example, Ollama). This
# powers Mr. Kim chat, lessons, and debriefs without a paid API key. On supported
# desktop browsers, chat can also use Chrome's built-in on-device AI.
AI_TUTOR_BASE_URL=
AI_TUTOR_MODEL=
AI_TUTOR_API_KEY=
# Do not add any readable developer password to production settings.
